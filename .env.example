# URL used by the Next.js server to reach the FastAPI backend.
BACKEND_URL=http://127.0.0.1:8000
# Browser-side URL used by the Phase 4 analyzer.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://jobfit:change-me@127.0.0.1:5432/jobfit
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development
MAX_UPLOAD_BYTES=5242880

# Stripe configuration is required for real checkout/webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
